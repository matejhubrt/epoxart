---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getSiteData } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  /** admin pages: no site chrome, hidden from search engines */
  bare?: boolean;
}
const {
  title,
  description = "EpoxArt — ruční výroba nábytku a doplňků z masivu a epoxidové pryskyřice.",
  bare = false,
} = Astro.props;

const { content } = bare ? { content: null } : await getSiteData();
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {bare && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · EpoxArt</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-page">
    {!bare && <Nav />}
    <main>
      <slot />
    </main>
    {content && <Footer texts={content.texts} />}

    <script>
      const seen = new WeakSet<Element>();
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              seen.add(entry.target);
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
</style>
