---
interface Props {
  label?: string;
  glow?: boolean;
  class?: string;
}
const { label, glow = false, class: className = "" } = Astro.props;
---

<div class:list={["hatch relative overflow-hidden", className]}>
  {glow && (
    <>
      <div
        class="pointer-events-none absolute -right-10 -top-10 h-72 w-72 rounded-full blur-3xl"
        style="background: radial-gradient(closest-side, rgba(185,138,78,.28), transparent);"
      />
      <div
        class="pointer-events-none absolute -bottom-16 -left-16 h-72 w-72 rounded-full blur-3xl"
        style="background: radial-gradient(closest-side, rgba(31,110,99,.24), transparent);"
      />
    </>
  )}
  {label && (
    <div class="absolute inset-0 flex items-center justify-center px-4 text-center font-mono text-[11px] tracking-wide text-faint">
      [ {label} ]
    </div>
  )}
</div>
