---
const menu = [
  { href: "/produkty", label: "Produkty" },
  { href: "/vyroba-na-miru", label: "Výroba na míru" },
  { href: "/o-nas", label: "O nás" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<footer class="border-t border-border bg-footer">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-8 px-6 py-12 text-[13px] text-muted sm:px-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="font-display text-2xl tracking-[0.12em] text-ink">EPOXART</div>
      <p class="mt-3 max-w-xs leading-relaxed">
        Ruční výroba unikátního nábytku z masivu a epoxidové pryskyřice. Každý kus je originál vytvořený s láskou k řemeslu.
      </p>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Menu</div>
      <ul class="space-y-2">
        {menu.map((m) => (
          <li><a href={m.href} class="hover:text-ink">{m.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Kontakt</div>
      <ul class="space-y-2">
        <li><a href="tel:+420732861160" class="hover:text-ink">+420 732 861 160</a></li>
        <li><a href="mailto:info@epoxart.cz" class="hover:text-ink">info@epoxart.cz</a></li>
        <li>Čenkov 163, 262 23</li>
      </ul>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Sledujte nás</div>
      <ul class="space-y-2">
        <li><a href="https://www.instagram.com/epoxart19/" target="_blank" rel="noopener noreferrer" class="hover:text-ink">Instagram</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61573065113314" target="_blank" rel="noopener noreferrer" class="hover:text-ink">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border px-6 py-4 text-center text-xs text-faintest sm:px-10">
    © 2026 EpoxArt. Všechna práva vyhrazena.
  </div>
</footer>
