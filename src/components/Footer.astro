---
import type { SiteTexts } from "../lib/content";
import { phoneHref } from "../lib/content";

interface Props {
  texts: SiteTexts;
}
const { texts } = Astro.props;

const menu = [
  { href: "/produkty", label: "Produkty" },
  { href: "/vyroba-na-miru", label: "Výroba na míru" },
  { href: "/o-nas", label: "O nás" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<footer class="border-t border-border bg-footer">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-8 px-6 py-12 text-[13px] text-muted sm:px-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="font-display text-2xl tracking-[0.12em] text-ink">EPOXART</div>
      <p class="mt-3 max-w-xs leading-relaxed">{texts.footerText}</p>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Menu</div>
      <ul class="space-y-2">
        {menu.map((m) => (
          <li><a href={m.href} class="hover:text-ink">{m.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Kontakt</div>
      <ul class="space-y-2">
        <li><a href={phoneHref(texts.phone1)} class="hover:text-ink">{texts.phone1}</a></li>
        <li><a href={`mailto:${texts.email}`} class="hover:text-ink">{texts.email}</a></li>
        <li>{texts.address}</li>
      </ul>
    </div>

    <div>
      <div class="mb-3 font-medium text-ink">Sledujte nás</div>
      <ul class="space-y-2">
        <li><a href={texts.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-ink">Instagram</a></li>
        <li><a href={texts.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-ink">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="flex flex-col items-center gap-3 border-t border-border px-6 py-4 text-center text-xs text-faintest sm:flex-row sm:justify-between sm:px-10">
    <span>© 2026 EpoxArt. Všechna práva vyhrazena.</span>
    <span class="flex gap-4">
      <a href="/obchodni-podminky" class="hover:text-ink">Obchodní podmínky</a>
      <a href="/ochrana-osobnich-udaju" class="hover:text-ink">Ochrana osobních údajů</a>
    </span>
  </div>
</footer>
