---
interface Props {
  href: string;
  variant?: "dark" | "outline" | "teal" | "teal-outline";
  class?: string;
}
const { href, variant = "dark", class: className = "" } = Astro.props;

const variants: Record<string, string> = {
  dark: "bg-ink text-page hover:bg-[#17130f]",
  outline: "border border-ink text-ink hover:bg-ink hover:text-page",
  teal: "bg-teal text-page hover:bg-teal-hover",
  "teal-outline": "border border-teal text-teal hover:bg-teal hover:text-page",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center whitespace-nowrap rounded-full px-[34px] py-[17px] text-[13px] tracking-[0.06em] transition-colors",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
