---
// The hero's call to action for the configurator: a small round tabletop (oak with a resin river)
// that slowly changes the colour of its resin, so the button shows what the configurator does.
interface Props {
  href: string;
  tone?: "light" | "dark";
}
const { href, tone = "light" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "cfg-cta group inline-flex items-center gap-4 rounded-full py-2 pl-2 pr-7 text-[14px] tracking-[0.04em] shadow-[0_12px_32px_-10px_rgba(0,0,0,.55)] transition duration-300 hover:-translate-y-0.5",
    tone === "light" ? "bg-surface text-ink hover:bg-white" : "bg-ink text-page hover:bg-[#17130f]",
  ]}
>
  <!-- the EpoxArt mark (same drawing as the favicon): the wooden tile with its resin river -->
  <svg viewBox="0 0 512 512" class="cfg-disc h-12 w-12 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id="cfg-wood" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#7a4d2a"></stop>
        <stop offset="1" stop-color="#4f3119"></stop>
      </linearGradient>
    </defs>
    <rect width="512" height="512" rx="112" fill="url(#cfg-wood)"></rect>
    <path
      class="cfg-river"
      d="M 210 40 C 260 40 260 120 300 160 C 340 200 300 280 300 340 C 300 400 260 472 210 472 C 230 380 190 340 190 256 C 190 172 230 120 210 40 Z"
    ></path>
    <path
      d="M 210 40 C 260 40 260 120 300 160 C 340 200 300 280 300 340 C 300 400 260 472 210 472"
      fill="none"
      stroke="#ffffff"
      stroke-opacity=".22"
      stroke-width="8"
      stroke-linecap="round"></path>
  </svg>
  <span class="font-medium">Navrhněte si vlastní stůl</span>
  <span class="cfg-arrow text-lg leading-none" aria-hidden="true">→</span>
</a>
