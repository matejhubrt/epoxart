---
import Hatch from "./Hatch.astro";

interface Props {
  src?: string | null;
  alt?: string;
  label?: string;
  glow?: boolean;
  class?: string;
  eager?: boolean;
  /** key of the editable site photo (lets the logged-in owner replace it in place) */
  edit?: string;
}
const { src, alt = "", label, glow = false, class: className = "", eager = false, edit } = Astro.props;
---

{src ? (
  <img
    src={src}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    data-edit-image={edit}
    class:list={["block w-full object-cover", className]}
  />
) : (
  <Hatch label={label} glow={glow} class={className} edit={edit} />
)}
