---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.tsx";
import { getSiteData } from "../lib/data";
import { CATEGORY_KEYS } from "../lib/products";

const { products, content } = await getSiteData();
const { texts } = content;

const visibleCategories = CATEGORY_KEYS.filter((c) => !content.categories.hidden.includes(c));
const catParam = Astro.url.searchParams.get("kat");
const initialCat = visibleCategories.find((c) => c === catParam) ?? "vse";
---

<Layout
  title="Produkty"
  description="Stoly, prkénka a kuchyňské linky z masivního dřeva, epoxidové pryskyřice a laminátových desek — ruční výroba EpoxArt."
>
  <div class="mx-auto max-w-content px-[28px] py-16">
    <p class="font-mono text-xs tracking-[0.28em] text-amber">PRODUKTY</p>
    <h1 data-edit-text="productsTitle" class="mt-4 font-display text-[44px] font-medium sm:text-[60px]">{texts.productsTitle}</h1>

    <div class="mt-10">
      <ProductGrid
        client:load
        products={products}
        categories={visibleCategories}
        initialCat={initialCat}
      />
    </div>
  </div>
</Layout>
