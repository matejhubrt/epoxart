---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.tsx";
import { getSiteData } from "../lib/data";
import { CATEGORY_KEYS } from "../lib/products";

const { products } = await getSiteData();

const catParam = Astro.url.searchParams.get("kat");
const initialCat = CATEGORY_KEYS.find((c) => c === catParam) ?? "vse";
---

<Layout title="Produkty">
  <div class="mx-auto max-w-content px-[28px] py-16">
    <p class="font-mono text-xs tracking-[0.28em] text-amber">PRODUKTY</p>
    <h1 class="mt-4 font-display text-[44px] font-medium sm:text-[60px]">Naše produkty</h1>

    <div class="mt-10">
      <ProductGrid client:load products={products} initialCat={initialCat} />
    </div>
  </div>
</Layout>
