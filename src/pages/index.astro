---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import Pill from "../components/Pill.astro";
import ConfiguratorCta from "../components/ConfiguratorCta.astro";
import InfoCards from "../components/InfoCards.astro";
import { getSiteData } from "../lib/data";
import { CATEGORY_LABELS, HOME_CATEGORY_KEYS, categoryHref, type CategoryKey } from "../lib/products";

const { content } = await getSiteData();
const { texts, images } = content;

// which editable text holds the small caption under each tile
const collectionSubKeys: Partial<Record<CategoryKey, "subStoly" | "subPrkenka" | "subKuchyne">> = {
  stoly: "subStoly",
  prkenka: "subPrkenka",
  kuchyne: "subKuchyne",
};
const collections = HOME_CATEGORY_KEYS.filter((cat) => !content.categories.hidden.includes(cat)).map(
  (cat) => ({
    cat,
    label: CATEGORY_LABELS[cat],
    subKey: collectionSubKeys[cat]!,
    sub: texts[collectionSubKeys[cat]!],
    image: images.categories[cat],
  })
);

// keep the tiles evenly spread when the owner switches some categories off
const mdCols: Record<number, string> = {
  1: "md:grid-cols-1",
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
};
const collectionGridCols = mdCols[collections.length] ?? "md:grid-cols-4";
const heroPhoto = Boolean(images.hero);
---

<Layout
  title="Úvod"
  description="EpoxArt — ruční výroba originálních stolů, prkének a kuchyňských linek z masivního dřeva, epoxidové pryskyřice a laminátových desek. Navrhněte si stůl na míru v konfigurátoru."
>
  <div class="mx-auto max-w-content px-[28px] pt-[28px]">
    <section class="relative flex h-[600px] items-center justify-center overflow-hidden rounded-[26px]">
      <Photo
        src={images.hero}
        alt="Ruční river stůl z masivního dřeva s epoxidovou pryskyřicí od EpoxArt"
        glow
        class="kenburns absolute inset-0 h-full"
        eager
        edit="hero"
      />
      {heroPhoto && (
        <div
          class="pointer-events-none absolute inset-0"
          style="background: radial-gradient(70% 75% at 50% 50%, rgba(22,15,10,.5), rgba(22,15,10,.22) 70%, rgba(22,15,10,.08) 100%);"
        ></div>
      )}
      <div class="relative z-10 mx-auto max-w-[820px] px-6 text-center">
        <p
          data-edit-text="heroEyebrow"
          style="--d:.1s"
          class:list={["anim-up font-mono text-xs tracking-[0.28em]", heroPhoto ? "text-white/90" : "text-amber"]}
        >
          {texts.heroEyebrow}
        </p>
        <h1
          style="--d:.25s"
          class:list={[
            "anim-up mt-5 font-display text-[56px] font-medium leading-[1] sm:text-[72px] md:text-[88px]",
            heroPhoto && "text-white [text-shadow:0_2px_24px_rgba(0,0,0,.35)]",
          ]}
        >
          <span data-edit-text="heroTitle1">{texts.heroTitle1}</span> <br />
          <em data-edit-text="heroTitle2" class:list={["not-italic italic", heroPhoto ? "text-[#a6e0d3]" : "text-teal"]}>{texts.heroTitle2}</em>
        </h1>
        <p
          data-edit-text="heroText"
          style="--d:.45s"
          class:list={[
            "anim-up mx-auto mt-6 max-w-[540px] text-[17px] leading-[1.7]",
            heroPhoto ? "text-white/95 [text-shadow:0_1px_12px_rgba(0,0,0,.4)]" : "text-body",
          ]}
        >
          {texts.heroText}
        </p>
        <div class="anim-up mt-8 flex flex-col items-center gap-4" style="--d:.65s">
          <ConfiguratorCta href="/vyroba-na-miru" tone={heroPhoto ? "light" : "dark"} />
          <a
            href="/produkty"
            class:list={[
              "group rounded-full px-4 py-1.5 text-sm transition-colors duration-300",
              heroPhoto
                ? "text-white/95 hover:bg-white/15 hover:text-white"
                : "text-brown-link hover:bg-ink/5 hover:text-teal",
            ]}
          >
            nebo si prohlédněte hotové produkty
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  {collections.length > 0 && (
    <section class="mx-auto max-w-content px-[28px] pb-8 pt-16">
      <div class="mb-6 flex items-end justify-between">
        <h2 data-edit-text="collectionsTitle" class="font-display text-[44px] font-medium">{texts.collectionsTitle}</h2>
        <a href="/produkty" class="text-sm text-brown-link hover:text-teal">Zobrazit vše →</a>
      </div>
      <div class={`grid grid-cols-1 gap-[18px] sm:grid-cols-2 ${collectionGridCols}`}>
        {collections.map((c, i) => (
          <a
            href={categoryHref(c.cat)}
            data-reveal
            style={`transition-delay:${i * 0.06}s`}
            class="card-lift group overflow-hidden rounded-[22px] bg-surface"
          >
            <div class="img-zoom h-[300px] overflow-hidden">
              <Photo
                src={c.image}
                alt={c.label}
                label={c.label}
                edit={`cat:${c.cat}`}
                class="h-full"
              />
            </div>
            <div class="px-[22px] py-[18px]">
              <div class="font-display text-2xl">{c.label}</div>
              <div data-edit-text={c.subKey} class="text-xs text-brown-link">{c.sub}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <InfoCards listKey="why" cards={content.blocks.why} reveal />

  <section class="mx-auto max-w-content px-[28px] py-16">
    <!-- no tile: centred straight on the page; each part fades in one after the other on scroll -->
    <div class="mx-auto max-w-[680px] text-center">
      <span data-reveal="scale" class="mx-auto block h-px w-24 bg-teal/50"></span>
      <p data-reveal style="transition-delay:.08s" class="mt-10 font-mono text-xs tracking-[0.28em] text-teal">
        VÝROBA NA MÍRU
      </p>
      <h2
        data-reveal
        data-edit-text="customTitle"
        style="transition-delay:.16s"
        class="mt-5 font-display text-[38px] font-medium leading-[1.05] sm:text-[58px]"
      >
        {texts.customTitle}
      </h2>
      <p
        data-reveal
        data-edit-text="customText"
        style="transition-delay:.26s"
        class="mx-auto mt-5 max-w-[480px] text-[15px] leading-relaxed text-body"
      >
        {texts.customText}
      </p>
      <!-- starts as a circle, stretches into the button when it scrolls into view -->
      <div data-reveal="morph" class="mx-auto mt-10 max-w-[340px]">
        <Pill
          href="/vyroba-na-miru"
          variant="teal"
          class="morph-pill text-[15px] shadow-[0_10px_30px_-8px_rgba(31,110,99,.55)] hover:shadow-[0_14px_34px_-8px_rgba(31,110,99,.65)]"
        >
          <span>SPUSTIT KONFIGURÁTOR →</span>
        </Pill>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-[28px] py-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-display text-[34px] font-medium">@epoxart19</h2>
      <a
        href={texts.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-brown-link hover:text-teal"
      >
        Sledovat na Instagramu →
      </a>
    </div>
    <div class="grid grid-cols-3 gap-3 md:grid-cols-6">
      {images.instagram.map((src, i) => (
        <a
          href={texts.instagram}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style={`transition-delay:${i * 0.06}s`}
          class="block aspect-square overflow-hidden rounded-2xl"
        >
          <Photo
            src={src}
            alt={`Ukázka práce EpoxArt na Instagramu, fotka ${i + 1}`}
            edit={`insta:${i}`}
            class="h-full w-full"
          />
        </a>
      ))}
    </div>
  </section>
</Layout>
