---
import Layout from "../layouts/Layout.astro";
import Configurator from "../components/Configurator.tsx";
import { getSiteData } from "../lib/data";

const { content } = await getSiteData();
const { texts } = content;
---

<Layout
  title="Výroba na míru"
  description="Navrhněte si stůl na míru — vyberte dřevo, odstín pryskyřice, tvar i směr epoxidové řeky v interaktivním konfigurátoru a pošlete nezávaznou poptávku."
>
  <div class="mx-auto max-w-content px-[28px] py-16">
    <p class="font-mono text-xs tracking-[0.28em] text-amber">VÝROBA NA MÍRU</p>
    <h1 data-edit-text="configTitle" class="mt-4 font-display text-[44px] font-medium sm:text-[60px]">{texts.configTitle}</h1>
    <p data-edit-text="configText" class="mt-4 max-w-2xl text-[15px] leading-relaxed text-body">
      {texts.configText}
    </p>

    <div class="mt-12">
      <Configurator
        client:load
        hiddenWoods={content.configurator.hiddenWoods}
        pigments={content.configurator.pigments}
        woodInfo={content.configurator.woodInfo}
      />
    </div>
  </div>
</Layout>
