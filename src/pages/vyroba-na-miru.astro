---
import Layout from "../layouts/Layout.astro";
import Configurator from "../components/Configurator.tsx";
---

<Layout title="Výroba na míru">
  <div class="mx-auto max-w-content px-[28px] py-16">
    <p class="font-mono text-xs tracking-[0.28em] text-amber">VÝROBA NA MÍRU</p>
    <h1 class="mt-4 font-display text-[44px] font-medium sm:text-[60px]">Konfigurátor stolu</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-body">
      Sestavte si vlastní kus. Vyberte dřevo, odstín pryskyřice, tvar a směr řeky — náhled se mění
      podle vás. Na závěr nám pošlete nezávaznou poptávku.
    </p>

    <div class="mt-12">
      <Configurator client:load />
    </div>
  </div>
</Layout>
