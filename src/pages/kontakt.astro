---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.tsx";
import { getSiteData } from "../lib/data";
import { phoneHref } from "../lib/content";

const { content } = await getSiteData();
const { texts } = content;
---

<Layout title="Kontakt">
  <div class="mx-auto max-w-content px-[28px] py-16">
    <p class="font-mono text-xs tracking-[0.28em] text-amber">KONTAKT</p>
    <h1 class="mt-4 font-display text-[44px] font-medium sm:text-[60px]">Ozvěte se nám</h1>

    <div class="mt-10 grid grid-cols-1 items-start gap-10 md:grid-cols-[0.85fr_1.15fr]">
      <div class="flex flex-col gap-[22px] rounded-[20px] bg-surface p-[26px]">
        <div>
          <div class="text-xs tracking-[0.14em] text-brown-link">TELEFON</div>
          <div class="mt-1 text-[15px]">
            <a href={phoneHref(texts.phone1)} class="hover:text-teal">{texts.phone1}</a>
            {texts.phone2 && (
              <>
                <br />
                <a href={phoneHref(texts.phone2)} class="hover:text-teal">{texts.phone2}</a>
              </>
            )}
          </div>
        </div>
        <div>
          <div class="text-xs tracking-[0.14em] text-brown-link">E-MAIL</div>
          <div class="mt-1 text-[15px]">
            <a href={`mailto:${texts.email}`} class="hover:text-teal">{texts.email}</a>
          </div>
        </div>
        <div>
          <div class="text-xs tracking-[0.14em] text-brown-link">SÍDLO</div>
          <div class="mt-1 text-[15px] leading-relaxed">
            {texts.owner}<br />
            EpoxArt<br />
            {texts.address}<br />
            IČO: {texts.ico}
          </div>
        </div>
        <div class="flex gap-3">
          <a
            href={texts.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 rounded-2xl bg-page px-4 py-3 text-center text-sm hover:text-teal"
          >
            Instagram
          </a>
          <a
            href={texts.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 rounded-2xl bg-page px-4 py-3 text-center text-sm hover:text-teal"
          >
            Facebook
          </a>
        </div>
      </div>

      <ContactForm client:load />
    </div>
  </div>
</Layout>
