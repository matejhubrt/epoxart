---
import Layout from "../../layouts/Layout.astro";
import PhotoGallery from "../../components/PhotoGallery.astro";
import ContactForm from "../../components/ContactForm.tsx";
import { getSiteData } from "../../lib/data";

const { content } = await getSiteData();
// the owner can switch the category off in the admin; then this page is gone too
if (content.categories.hidden.includes("kuchyne")) {
  return Astro.redirect("/produkty");
}
const { texts, kitchens } = content;
---

<Layout
  title="Kuchyňské linky na zakázku"
  description="Kuchyně na zakázku z laminátových desek — prohlédněte si hotové realizace, nechte se inspirovat a pošlete nám nezávaznou poptávku."
>
  <div class="mx-auto max-w-content px-[28px] py-12 sm:py-16">
    <nav aria-label="Drobečková navigace" class="text-[13px] text-muted">
      <a href="/produkty" class="hover:text-teal">← Všechny produkty</a>
      <span class="mx-2 text-faintest">/</span>
      <span>Kuchyňské linky</span>
    </nav>

    <p class="mt-8 font-mono text-xs tracking-[0.28em] text-amber">KUCHYŇSKÉ LINKY</p>
    <h1 data-edit-text="kitchenTitle" class="mt-4 font-display text-[44px] font-medium leading-[1.04] sm:text-[60px]">
      {texts.kitchenTitle}
    </h1>
    <p data-edit-text="kitchenText" class="mt-5 max-w-3xl text-[16px] leading-[1.8] text-body">
      {texts.kitchenText}
    </p>
    <a
      href="#poptavka"
      class="btn-press mt-7 rounded-full bg-teal px-8 py-3.5 text-[13px] tracking-[0.06em] text-page hover:bg-teal-hover"
    >
      POPTAT KUCHYŇ
    </a>

    <h2 data-edit-text="kitchenGalleryTitle" class="mt-16 font-display text-[34px] font-medium sm:text-[42px]">
      {texts.kitchenGalleryTitle}
    </h2>
    <PhotoGallery
      photos={kitchens.photos}
      editKey="kitchens"
      class="mt-6"
      altPrefix="Hotová kuchyně od EpoxArt"
      emptyText="Fotky hotových kuchyní připravujeme. Napište nám a rádi vám ukážeme, co umíme."
    />

    <section id="poptavka" class="mt-20 grid scroll-mt-28 grid-cols-1 items-start gap-10 md:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal>
        <p class="font-mono text-xs tracking-[0.28em] text-amber">POPTÁVKA</p>
        <h2 class="mt-4 font-display text-[36px] font-medium leading-tight sm:text-[44px]">
          Navrhneme kuchyň přesně pro vás
        </h2>
        <p class="mt-4 text-[15px] leading-[1.8] text-body">
          Všechny kuchyně vyrábíme na zakázku. Cenu stanovíme individuálně podle rozměrů,
          zvoleného dekoru a vybavení. Poptávka je nezávazná.
        </p>
        <p class="mt-5 text-sm font-semibold">Co nám pomůže, když napíšete:</p>
        <ul class="mt-3 space-y-2.5 text-[14.5px] text-body">
          <li class="flex gap-3"><span class="text-teal">✓</span> rozměry a tvar místnosti, případně náčrt nebo fotku</li>
          <li class="flex gap-3"><span class="text-teal">✓</span> jaký dekor si představujete (např. černé lamino, bílé lamino s černou deskou)</li>
          <li class="flex gap-3"><span class="text-teal">✓</span> spotřebiče a dřez, které chcete zabudovat</li>
          <li class="flex gap-3"><span class="text-teal">✓</span> kdy byste kuchyň potřebovali</li>
        </ul>
        <p class="mt-5 text-[13px] text-muted">
          Kuchyně doručujeme osobně. Termín a místo předání domluvíme předem.
        </p>
      </div>

      <div data-reveal style="transition-delay:.1s">
        <ContactForm
          client:load
          title="Poptávka kuchyně"
          subject="Poptávka kuchyně"
          messagePlaceholder="Popište prosím svou představu: rozměry a tvar místnosti, dekor, spotřebiče, termín…"
          submitLabel="ODESLAT POPTÁVKU"
          sentText="Děkujeme za poptávku! Ozveme se vám co nejdříve."
        />
      </div>
    </section>
  </div>
</Layout>
