# Copy to .env for local development; on Vercel add the same two variables
# (Project -> Settings -> Environment Variables). Both values are safe to be public:
# what visitors and the owner can do is enforced by the database rules in supabase/schema.sql.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
